generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  password         String?
  credits          Int              @default(20)
  plan             String           @default("FREE")
  stripeCustomerId String?          @unique
  affiliateCode    String?          @unique // User's own affiliate code
  referredBy       String?          // Which affiliate referred this user
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  ads              Ad[]
  subscriptions    Subscription[]
  creations        Creation[]
  rateLimitUsage   RateLimitUsage[]
  visitorStats     VisitorStats[]
  affiliate        Affiliate?       // If user is an affiliate
  referrals        Referral[]       @relation("AffiliateReferrals")
  commissions      Commission[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  status               String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean?  @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id])
}

model Ad {
  id                     String   @id @default(cuid())
  userId                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  productUrl             String?
  summary                String?
  brandName              String?
  logoUrl                String?
  description            String?
  selectedImages         String?
  selectedVideos         String?
  selectedBRoll          String?
  orderedImages          String?
  orderedVideos          String?
  orderedBRoll           String?
  showPromo              Boolean? @default(false)
  originalPrice          String?
  promoPrice             String?
  promoDetails           String?
  format                 String?
  duration               Int?
  language               String?
  audience               String?
  script                 String?
  avatarId               String?
  templateId             String?
  status                 String   @default("PENDING")
  finalVideoUrl          String?
  audioUrl               String?
  wordTimings            String?  
  isWatermarked          Boolean  @default(true)
  inngestRunId           String?  @unique
  syncLabsJobId          String?
  backgroundMusicUrl     String?
  backgroundMusicVolume  Int?
  enableDualFormat       Boolean? @default(false)
  finalVideoUrl4x5       String?
  lipsyncedAvatarNoBgUrl String?
  lipsyncedAvatarUrl     String?
  fontSize               Int?     @default(50)
  oneWordAtATime         Boolean? @default(false)
  enableSubtitles        Boolean? @default(true)
  fontWeight             Int?     @default(700)
  letterSpacing          Int?
  outlineColor           String?
  outlineWidth           Int?
  shadowBlur             Int?
  shadowColor            String?
  shadowOffsetX          Int?
  shadowOffsetY          Int?
  subtitleAnimation      String?  @default("none")
  subtitlePosition       String?  @default("bottom")
  subtitleStyle          String?  @default("inter")
  textColor              String?  @default("#ffffff")
  textTransform          String?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Creation {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  videoUrl    String?
  assets      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  watermarked Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimitUsage {
  id          String   @id @default(cuid())
  userId      String
  action      String
  count       Int      @default(1)
  windowStart DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, windowStart])
  @@index([userId, action, windowStart])
}

model VisitorStats {
  id        String   @id @default(cuid())
  sessionId String
  page      String
  userAgent String?
  referrer  String?
  country   String?
  timestamp DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([page, timestamp])
  @@index([sessionId])
  @@index([timestamp])
}

// Affiliate System Models
model Affiliate {
  id              String        @id @default(cuid())
  userId          String        @unique
  affiliateCode   String        @unique
  isActive        Boolean       @default(true)
  commissionRate  Float         @default(0.10) // 10% default
  payoutMethod    String?       // 'stripe', 'paypal', 'bank'
  payoutDetails   String?       // JSON string with payout info
  totalEarnings   Float         @default(0)
  paidOut         Float         @default(0)
  pendingPayout   Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals       Referral[]
  commissions     Commission[]
  payouts         Payout[]
  clicks          AffiliateClick[]

  @@index([affiliateCode])
  @@index([isActive])
}

model Referral {
  id            String   @id @default(cuid())
  affiliateId   String
  userId        String   // The referred user
  affiliateCode String   // Snapshot of affiliate code at time of referral
  status        String   @default("PENDING") // PENDING, CONVERTED, CHURNED
  signupDate    DateTime @default(now())
  conversionDate DateTime?
  firstPurchaseAmount Float?
  totalSpent    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user          User     @relation("AffiliateReferrals", fields: [userId], references: [id], onDelete: Cascade)
  commissions   Commission[]

  @@index([affiliateId])
  @@index([userId])
  @@index([status])
  @@index([signupDate])
}

model Commission {
  id                  String      @id @default(cuid())
  affiliateId         String
  userId              String      // The user who made the purchase
  referralId          String?     // Link to the referral record
  subscriptionId      String?     // Stripe subscription ID
  amount              Float       // Commission amount in USD
  percentage          Float       // Commission percentage used
  purchaseAmount      Float       // Original purchase amount
  status              String      @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  type                String      // SIGNUP, RECURRING, ONE_TIME
  payoutId            String?     // If included in a payout
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  affiliate           Affiliate   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referral            Referral?   @relation(fields: [referralId], references: [id], onDelete: SetNull)
  payout              Payout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
}

model Payout {
  id              String       @id @default(cuid())
  affiliateId     String
  amount          Float
  currency        String       @default("USD")
  method          String       // 'stripe', 'paypal', 'bank'
  status          String       @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  stripePayoutId  String?      // If using Stripe
  paypalPayoutId  String?      // If using PayPal
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  affiliate       Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissions     Commission[]

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model AffiliateClick {
  id            String    @id @default(cuid())
  affiliateId   String
  affiliateCode String
  ipAddress     String?
  userAgent     String?
  referrer      String?
  landingPage   String    // Where they landed after clicking
  country       String?
  converted     Boolean   @default(false)
  userId        String?   // If the click resulted in a signup
  createdAt     DateTime  @default(now())
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([affiliateCode])
  @@index([createdAt])
  @@index([converted])
}
