generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum for plan names (managed in code due to SQLite limitations)
// enum Plan {
//   FREE
//   BASIC     // 499kr, 100 credits
//   PRO       // 999kr, 250 credits
//   PREMIUM   // 1499kr, 400 credits
// }

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime?
  name                String?
  image               String?
  credits             Int       @default(30)       // Initial credits for FREE plan
  plan                String    @default("FREE")   // e.g., "FREE", "BASIC", "PRO", "PREMIUM"
  stripeCustomerId    String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accounts            Account[]
  sessions            Session[]
  ads                 Ad[]
  subscriptions       Subscription[]
  creations           Creation[]
}

model Subscription {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id])
  stripeSubscriptionId    String    @unique
  stripePriceId           String    // From Stripe Dashboard
  status                  String    // e.g., "active", "canceled", "incomplete", "past_due"
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean?  @default(false)
  canceledAt              DateTime?
  trialStart              DateTime?
  trialEnd                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Ad {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  productUrl      String?
  summary         String?
  brandName       String?
  logoUrl         String?
  description     String?
  selectedImages  String?
  selectedVideos  String?
  showPromo       Boolean?  @default(false)
  originalPrice   String?
  promoPrice      String?
  promoDetails    String?
  format          String?
  duration        Int?
  language        String?
  audience        String?
  script          String?
  avatarId        Int?
  templateId      Int?
  status          String   @default("PENDING")
  finalVideoUrl   String?
  isWatermarked   Boolean   @default(true)
}

model Creation {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  title       String
  description String
  videoUrl    String?
  assets      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  watermarked Boolean  @default(true)
}

// For NextAuth
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
} 